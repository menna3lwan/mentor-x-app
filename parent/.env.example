# ──────────────────────────────────────────────────────────────────────────
# MentorX Parent — environment template
#
# Usage:
#   1. Copy this file to `.env` (or `.env.local`, `.env.production`).
#   2. Fill in MENTORX_API_BASE_URL and keep / flip the repository modes.
#   3. Build the app with:
#        flutter run --dart-define-from-file=.env
#        flutter build apk --dart-define-from-file=.env.production
#
# Notes:
# - Every repository defaults to `prod` in code (see lib/core/utils/env.dart).
#   You only need to override here to develop against mocks.
# - When ANY repository is in `prod` mode, MENTORX_API_BASE_URL is required.
# ──────────────────────────────────────────────────────────────────────────

# App Configuration
DEFAULT_LANGUAGE_CODE=ar
DEFAULT_OTP_CODE_LENGTH=6

# Backend — required when any repository is in PROD mode.
MENTORX_API_BASE_URL=

# ── Repository modes (mock | prod) ─────────────────────────────────────────
AUTHENTICATION_REPOSITORY_MODE=prod
HOME_REPOSITORY_MODE=prod
CHILDREN_REPOSITORY_MODE=prod
FINANCIAL_REPOSITORY_MODE=prod
COURSE_REPOSITORY_MODE=prod
ATTENDANCE_REPOSITORY_MODE=prod
GRADE_REPOSITORY_MODE=prod
COMMUNICATION_REPOSITORY_MODE=prod
NOTIFICATION_REPOSITORY_MODE=prod
PROFILE_REPOSITORY_MODE=prod
ANALYTICS_REPOSITORY_MODE=prod
ATTENDANCE_GROUPS_REPOSITORY_MODE=prod

# ── Mock-only knobs (ignored when modes are `prod`) ────────────────────────
MOCK_DELAY_IN_SECONDS=1
MOCK_USER_PHONE_NUMBER=01000000000
MOCK_OTP_CODE=123456
MOCK_USER_NAME="John Doe"
