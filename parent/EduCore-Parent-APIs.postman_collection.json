{
  "info": {
    "name": "EduCore - Parent APIs",
    "_postman_id": "parent-api-collection-001",
    "description": "جميع endpoints الخاصة بولي الأمر في EduCore API\nBase URL: http://api.foudz.store",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://api.foudz.store",
      "type": "string"
    },
    {
      "key": "parentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Parent Login",
      "description": "تسجيل دخول ولي الأمر عبر OTP",
      "item": [
        {
          "name": "1. Start Login (إرسال OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parent/start-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parent",
                "start-login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentPhone\": \"01041864622\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "إرسال رقم جوال ولي الأمر لاستلام كود OTP"
          }
        },
        {
          "name": "2. Complete Login (التحقق من OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parent/complete-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parent",
                "complete-login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentPhone\": \"01041864622\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "إدخال رقم الجوال وكود OTP لإتمام تسجيل الدخول والحصول على الـ token"
          }
        },
        {
          "name": "3. Logout (تسجيل الخروج)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{parentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parent/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parent",
                "logout"
              ]
            },
            "description": "تسجيل خروج ولي الأمر"
          }
        }
      ]
    },
