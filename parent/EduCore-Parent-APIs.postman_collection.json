              "raw": "{{baseUrl}}/api/parent/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parent",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"اسم ولي الأمر\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "تعديل بروفايل ولي الأمر"
          }
        },
        {
          "name": "Upload Profile Image (رفع صورة البروفايل)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{parentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parent/profile/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parent",
                "profile",
                "image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "صورة البروفايل (JPEG/PNG)"
                }
              ]
            },
            "description": "رفع صورة البروفايل لولي الأمر"
          }
        }
      ]
    },
