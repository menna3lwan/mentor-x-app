# ──────────────────────────────────────────────────────────────────────────
# MentorX Parent — fully-mocked dev configuration
#
# Use when you want to run the app offline against in-memory fixtures:
#   flutter run --dart-define-from-file=.env.mock
#
# No network calls are made; MENTORX_API_BASE_URL is intentionally blank.
# ──────────────────────────────────────────────────────────────────────────

DEFAULT_LANGUAGE_CODE=ar
DEFAULT_OTP_CODE_LENGTH=6

MENTORX_API_BASE_URL=

AUTHENTICATION_REPOSITORY_MODE=mock
HOME_REPOSITORY_MODE=mock
CHILDREN_REPOSITORY_MODE=mock
FINANCIAL_REPOSITORY_MODE=mock
COURSE_REPOSITORY_MODE=mock
ATTENDANCE_REPOSITORY_MODE=mock
GRADE_REPOSITORY_MODE=mock
COMMUNICATION_REPOSITORY_MODE=mock
NOTIFICATION_REPOSITORY_MODE=mock
PROFILE_REPOSITORY_MODE=mock
ANALYTICS_REPOSITORY_MODE=mock
ATTENDANCE_GROUPS_REPOSITORY_MODE=mock
DEVICES_REPOSITORY_MODE=mock

MOCK_DELAY_IN_SECONDS=1
MOCK_USER_PHONE_NUMBER=01000000000
MOCK_OTP_CODE=123456
MOCK_USER_NAME="John Doe"
